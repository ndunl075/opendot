# Copy this file to .env and fill in a real username/password before
# running `docker compose up`. .env is gitignored; never commit real
# credentials here.
COUCHDB_USER=changeme
COUCHDB_PASSWORD=changeme

# Optional: leave unset (defaults to 127.0.0.1, unreachable from anywhere
# but this machine) unless you actually want to reach this from a phone
# over a VPN. Set to this host's own VPN/Tailscale IP if so -- see
# docker-compose.yml's comment on the ports line. Never "0.0.0.0".
# ALFRED_VAULT_SYNC_HOST=100.x.y.z
