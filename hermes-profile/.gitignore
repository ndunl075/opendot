# Per Hermes's own documented distribution conventions -- these are hard-
# excluded by `hermes profile install` regardless, but listed explicitly so
# nothing here ever gets committed by accident.
auth.json
.env
.env.local
state.db*
response_store.db*
gateway.pid
processes.json
memories/
sessions/
logs/
workspace/
plans/
home/
*_cache/

# Owner-only personality overrides. The tracked SOUL.md is the shareable
# default; keep a personal copy as SOUL.local.md on your machine and copy it
# over the installed profile when you want your own voice back.
SOUL.local.md
