        "review_verdict": {
          "anyOf": [
            {
              "enum": [
                "ok",
                "concern",
                "block"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Verdict"
        },
        "rule_suggestion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Suggestion"
        },
        "status": {
          "enum": [
            "pending",
            "approved",
            "edited",
            "denied",
            "expired"
          ],
          "title": "Status",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "status",
        "action",
        "title",
        "preview",
        "payload",
        "created_at"
