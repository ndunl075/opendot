    "intro_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Intro Message"
    },
    "weekly_limit_acknowledged": {
      "default": false,
      "title": "Weekly Limit Acknowledged",
      "type": "boolean"
    }
  },
  "required": [
    "current_step",
    "completed_steps",
    "chatgpt"
