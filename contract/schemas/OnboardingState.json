      },
      "title": "Completed Steps",
      "type": "array"
    },
    "credits_off_acknowledged": {
      "default": false,
      "title": "Credits Off Acknowledged",
      "type": "boolean"
    },
    "current_step": {
      "enum": [
        "companion",
        "chatgpt",
        "weekly_limit",
        "connections",
        "intro",
        "done"
