      },
      "required": [
        "state",
        "plan",
        "eligible",
        "manage_usage_url"
      ],
      "title": "ChatGPTStatus",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "avatar_seed": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Avatar Seed"
    },
    "chatgpt": {
      "$ref": "#/$defs/ChatGPTStatus"
    },
    "companion_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
