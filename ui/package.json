{
  "name": "@opendot/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "vite",
    "gen:types": "node scripts/generate-types.mjs",
    "check:types": "node scripts/check-types.mjs",
    "lint": "eslint . && tsc --noEmit",
